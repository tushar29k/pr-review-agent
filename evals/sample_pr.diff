+def charge_card(card_number, amount_cents):
+    # TODO: retry with backoff instead of failing silently
+    print("charging card ending in", card_number[-4:])
+    try:
+        resp = requests.post(
+            "https://api.payments.example/charge",
+            json={"card": card_number, "amount": amount_cents},
+            headers={"Authorization": f"Bearer {API_TOKEN}"},
+            timeout=10,
+        )
+        return resp.json()
+    except:
+        return {"ok": False}
+
+
+def refund(charge_id):
+    # FIXME: no idempotency key — double refunds possible
+    resp = requests.post(
+        "https://api.payments.example/refund",
+        json={"charge": charge_id},
+        timeout=10,
+    )
+    return resp.json()
